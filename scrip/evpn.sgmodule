#!name=EVA Xray Logger (Log to Script Log)
#!desc=Passive capture of /xray-connections. Prints access_url to Surge Script Log. Optional toast.
#!author=Minis

[MITM]
hostname = %APPEND% api.cookshowroom.org

[Header Rewrite]
^https?:\/\/api\.cookshowroom\.org\/xray-connections(?:\?.*)?$ header-add Accept-Encoding: identity

[Script]
# Log-only capture; precise pattern, allow optional query; longer timeout; cap body size
xray_log = type=http-response,pattern=^https?:\/\/api\.cookshowroom\.org\/xray-connections(?:\?.*)?$,requires-body=1,binary-body-mode=0,max-size=120000,timeout=20,script-path=https://raw.githubusercontent.com/DAlxbss/LXbbsv/main/scrip/evpn.js,script-update-interval=0
